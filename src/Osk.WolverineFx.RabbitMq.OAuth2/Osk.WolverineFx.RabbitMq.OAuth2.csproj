<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Version>6.49.0</Version>
    <Description>Automatic startup patches for WolverineFx 6.49 RabbitMQ OAuth2 token refresh.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/VladZainullin/Osk.WolverineFx.RabbitMq.OAuth2.Patch</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md"
          Pack="true"
          PackagePath="/"
          Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="RabbitMQ.Client.OAuth2" />
    <PackageReference Include="Lib.Harmony" />
    <ProjectReference Include="../Osk.WolverineFx.RabbitMq.OAuth2.Generator/Osk.WolverineFx.RabbitMq.OAuth2.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../Osk.WolverineFx.RabbitMq.OAuth2.Generator/bin/$(Configuration)/netstandard2.0/Osk.WolverineFx.RabbitMq.OAuth2.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../Osk.WolverineFx.RabbitMq.OAuth2.Generator/bin/$(Configuration)/netstandard2.0/Osk.WolverineFx.RabbitMq.OAuth2.Generator.xml" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <InternalsVisibleTo Include="Osk.WolverineFx.RabbitMq.OAuth2.Tests" />
    <InternalsVisibleTo Include="Osk.WolverineFx.RabbitMq.OAuth2.IntegrationTests" />
  </ItemGroup>
</Project>
